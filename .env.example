# Copy to .env and fill the empty values before the first boot.
# .env is gitignored. Keep these values stable: changing them later makes
# existing gateway keys or stored provider secrets unreadable.

POSTGRES_USER=gateway
POSTGRES_PASSWORD=
POSTGRES_DB=gateway
POSTGRES_PORT=5432
REDIS_PASSWORD=

# Host process pointing at the Compose database. Docker Compose sets
# POSTGRES_HOST=postgres inside the gateway container.
# POSTGRES_HOST=127.0.0.1

# Full SQLAlchemy URL. When set, it replaces the POSTGRES_* fields.
# GATEWAY_DATABASE_URL=

# Pool size for PostgreSQL.
# GATEWAY_DB_POOL_SIZE=5
# GATEWAY_DB_MAX_OVERFLOW=10

# Mixed into gateway API key hashes. Required by Docker Compose.
GATEWAY_KEY_PEPPER=

# Fernet key that encrypts provider secrets. Required by Docker Compose.
# poetry -C backend run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GATEWAY_MASTER_KEY=

# Compose binds the gateway, PostgreSQL, and Redis to 127.0.0.1.
# GATEWAY_PORT=8080
# REDIS_PORT=6379

# A machine run can point at the localhost Redis port:
# REDIS_URL=redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6379/0

# Vendor keys. On the first admin setup, a non-empty value is imported into the
# console as a provider. The gateway then stores an encrypted copy.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_BASE_URL=
# BEDROCK_API_KEY=
